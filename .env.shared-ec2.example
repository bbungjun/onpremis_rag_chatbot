TEAM_ENV_PROFILE=shared-ec2
# Replace with your shared EC2 Ollama endpoint.
OLLAMA_BASE_URL=http://YOUR_EC2_PUBLIC_IP:11434
LLM_MODEL=qwen3:4b-instruct
# auto: qwen3 thinking 모델만 think=true, -instruct 등 비-thinking 모델은 생략. on/off 로 강제 가능
LLM_THINK=auto
EMBEDDING_MODEL=bge-m3

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=llmenhance_chunks

RETRIEVAL_TOP_K=5
TEMPERATURE=0.2
NUM_CTX=4096
NUM_PREDICT=512

# Presentation comparison path
ENABLE_GEMINI_ENDPOINT=true
ENABLE_GEMINI_PANEL=true
ENABLE_BEDROCK_ENDPOINT=true
ENABLE_BEDROCK_PANEL=true
BEDROCK_REGION=ap-northeast-3
BEDROCK_MODEL_ID=jp.anthropic.claude-sonnet-4-6
BEDROCK_MODEL_LABEL=Claude Sonnet 4.6
BEDROCK_MAX_OUTPUT_TOKENS=512
PRESENTATION_TOP_K=5
